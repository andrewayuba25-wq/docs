# Reuses the same Postgres + Redis as the Node API. Run the docker-compose in
# apps/marketplace/infra/docker-compose.yml first.

DATABASE_URL=postgresql+asyncpg://artisan:artisan@localhost:5432/artisan
DATABASE_URL_SYNC=postgresql://artisan:artisan@localhost:5432/artisan

API_PORT=4001
API_BASE_URL=http://localhost:4001

# Use the SAME secrets as the Node API so JWTs are interchangeable.
JWT_ACCESS_SECRET=replace-with-32-byte-random-string
JWT_REFRESH_SECRET=replace-with-32-byte-random-string
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

TWILIO_FAKE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

S3_FAKE=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=artisan-uploads

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO
ENVIRONMENT=development
