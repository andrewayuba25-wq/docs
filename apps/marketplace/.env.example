# --- Database ---
DATABASE_URL=postgresql://artisan:artisan@localhost:5432/artisan?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
JWT_ACCESS_SECRET=replace-with-32-byte-random-string
JWT_REFRESH_SECRET=replace-with-32-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Twilio (phone OTP). Use TWILIO_FAKE=true in dev to bypass. ---
TWILIO_FAKE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# --- AWS S3 (uploads). Use S3_FAKE=true to use local MinIO via docker-compose. ---
S3_FAKE=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=artisan-uploads

# --- Google Maps (mobile + admin) ---
GOOGLE_MAPS_API_KEY=

# --- Stripe (Phase 2) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Expo / Push ---
EXPO_ACCESS_TOKEN=

# --- Misc ---
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
